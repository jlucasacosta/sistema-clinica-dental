# ESMALTE: variables de entorno. SOLO placeholders vacios: nunca pegues valores reales aca.
# Copia este archivo a .env.local y completalo (.env.local no se sube a Git).
# El demo corre SIN ninguna de estas variables. Se usan cuando conectas el backend:
# ver docs/IMPLEMENTAR.md.

# --- Supabase (base de datos + Auth). docs/IMPLEMENTAR.md, seccion 3 ---
# Project Settings > API. Estas dos son PUBLICAS (el navegador las ve): las protege RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role: se SALTEA toda la seguridad de la base.
# SOLO servidor / scripts locales (seed, worker de Railway). JAMAS lleva prefijo NEXT_PUBLIC_
# ni se carga en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Worker de Railway con pg-boss (va en las variables de Railway, no en Vercel) ---
# Cadena de conexion a Postgres: conexion directa o pooler en modo sesion. Seccion 4.
DATABASE_URL=

# --- IA: elegi UN proveedor. Solo en el servidor (Route Handler). Seccion 6 ---
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
